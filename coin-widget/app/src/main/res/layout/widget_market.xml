<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/panel" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:background="@drawable/panel">
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:includeFontPadding="false" android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:text="코인 시장 리포트" android:textColor="#15202C" android:textStyle="bold" android:textSize="16sp"/>
<TextView android:includeFontPadding="false" android:id="@+id/fx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="2" android:text="USD/KRW 조회 전" android:textColor="#53616D" android:textSize="10sp" android:gravity="end"/>
</LinearLayout>
<TextView android:includeFontPadding="false" android:id="@+id/btc_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="BTC  — 원" android:textColor="#15202C" android:textStyle="bold" android:textSize="22sp" android:maxLines="1" android:ellipsize="end"/>
<TextView android:includeFontPadding="false" android:id="@+id/btc_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="비트코인 · 업비트 원화 · 일봉" android:textColor="#63707D" android:textSize="10sp"/>
<ImageView android:id="@+id/btc_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" android:layout_marginTop="2dp" android:scaleType="fitXY" android:contentDescription="비트코인 일봉 차트. 조회 전에는 빈 차트로 표시됩니다."/>
<TextView android:includeFontPadding="false" android:id="@+id/dom_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="BTC 도미넌스 — %" android:textStyle="bold" android:textColor="#15202C" android:textSize="13sp"/>
<ImageView android:id="@+id/dom_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitXY" android:contentDescription="설치 후 수집한 BTC 도미넌스 관측 기록"/>
<TextView android:includeFontPadding="false" android:id="@+id/dom_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="설치 후 실제 관측값만 기록합니다." android:textColor="#63707D" android:textSize="9sp"/>
<TextView android:includeFontPadding="false" android:id="@+id/breadth" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="원화 알트 상승 비율 — %" android:textColor="#1C4268" android:textSize="11sp"/>
<TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="시장 종합 의견 · 규칙 기반" android:textColor="#15202C" android:textStyle="bold" android:textSize="13sp"/>
<TextView android:includeFontPadding="false" android:id="@+id/market_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="BTC: 자료 조회 전\n알트: 자료 조회 전" android:textColor="#263442" android:textSize="11sp" android:maxLines="3" android:ellipsize="end"/>
<TextView android:includeFontPadding="false" android:id="@+id/today" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="오늘 관찰 후보: 조회 전" android:textColor="#263442" android:textSize="11sp" android:maxLines="3" android:ellipsize="end"/>
<TextView android:includeFontPadding="false" android:id="@+id/next_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="내일 09:00 재확인: 조회 전" android:textColor="#263442" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
<TextView android:includeFontPadding="false" android:id="@+id/warning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="급등·수익률 보장 없음. 후보는 매수 지시가 아닙니다." android:textColor="#885132" android:textSize="9sp" android:maxLines="2" android:ellipsize="end"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical">
<TextView android:includeFontPadding="false" android:id="@+id/updated" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="2시간 자동 조회\n마지막 조회 —" android:textColor="#63707D" android:textSize="9sp" android:maxLines="3"/>
<TextView android:includeFontPadding="false" android:id="@+id/open_app" android:layout_width="48dp" android:layout_height="48dp" android:text="상세" android:textColor="#1C4268" android:textSize="11sp" android:gravity="center" android:contentDescription="상세 분석과 API 설정 열기"/>
<TextView android:includeFontPadding="false" android:id="@+id/refresh" android:layout_width="72dp" android:layout_height="48dp" android:text="↻ 새로고침" android:textColor="#1C4268" android:textStyle="bold" android:textSize="11sp" android:gravity="center" android:background="@drawable/button_bg" android:contentDescription="지금 시세와 분석 다시 조회"/>
</LinearLayout>
</LinearLayout>
