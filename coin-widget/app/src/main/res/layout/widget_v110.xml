<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/panel_new">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_2_text" android:textSize="17sp" android:textColor="#1C2940" android:includeFontPadding="false" android:textStyle="bold" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/fx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_3_text" android:textSize="10sp" android:textColor="#738096" android:includeFontPadding="false" android:gravity="end" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/btc_label" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_6_text" android:textSize="12sp" android:textColor="#1C2940" android:includeFontPadding="false" android:textStyle="bold" android:layout_weight="1" />
      <TextView android:id="@+id/btc_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_7_text" android:textSize="11sp" android:textColor="#6550CC" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/btc_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_8_text" android:textSize="26sp" android:textColor="#1C2940" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/btc_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_9_text" android:textSize="11sp" android:textColor="#738096" android:includeFontPadding="false" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/chart_legend" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_11_text" android:textSize="10sp" android:textColor="#738096" android:includeFontPadding="false" android:layout_marginTop="4dp" />
    </LinearLayout>
    <ImageView android:id="@+id/btc_chart" android:layout_width="match_parent" android:layout_height="82dp" android:scaleType="fitCenter" android:contentDescription="@string/ui_widget_v110_12_contentdescription" />
    <TextView android:id="@+id/btc_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_13_text" android:textSize="10sp" android:textColor="#738096" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
    <TextView android:id="@+id/dom_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_15_text" android:textSize="12sp" android:textColor="#1C2940" android:includeFontPadding="false" android:textStyle="bold" />
    <ImageView android:id="@+id/dom_chart" android:layout_width="match_parent" android:layout_height="34dp" android:scaleType="fitCenter" android:contentDescription="@string/ui_widget_v110_16_contentdescription" />
    <TextView android:id="@+id/dom_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_17_text" android:textSize="10sp" android:textColor="#738096" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/soft_card" android:padding="8dp" android:layout_marginTop="7dp">
    <TextView android:id="@+id/market_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_19_text" android:textSize="12sp" android:textColor="#6550CC" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/breadth" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_20_text" android:textSize="11sp" android:textColor="#738096" android:includeFontPadding="false" android:layout_marginTop="3dp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="7dp">
    <TextView android:id="@+id/tab_today" android:layout_width="0dp" android:layout_height="36dp" android:text="@string/ui_widget_v110_22_text" android:textSize="12sp" android:textColor="#6550CC" android:includeFontPadding="false" android:textStyle="bold" android:layout_weight="1" android:gravity="center" android:background="@drawable/tab_selected" />
    <TextView android:id="@+id/tab_morning" android:layout_width="0dp" android:layout_height="36dp" android:text="@string/ui_widget_v110_23_text" android:textSize="12sp" android:textColor="#6550CC" android:includeFontPadding="false" android:textStyle="bold" android:layout_weight="1" android:gravity="center" android:background="@drawable/tab_idle" />
  </LinearLayout>
  <TextView android:id="@+id/today" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_24_text" android:textSize="11sp" android:textColor="#1C2940" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="5dp" android:maxLines="1" android:ellipsize="end" />
  <TextView android:id="@+id/next_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_25_text" android:textSize="10sp" android:textColor="#738096" android:includeFontPadding="false" android:layout_marginTop="3dp" />
  <LinearLayout android:id="@+id/coin_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="3dp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/page_prev" android:layout_width="48dp" android:layout_height="36dp" android:text="@string/ui_widget_v110_28_text" android:textSize="23sp" android:textColor="#6550CC" android:includeFontPadding="false" android:gravity="center" android:contentDescription="@string/ui_widget_v110_28_contentdescription" />
    <TextView android:id="@+id/page_label" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_29_text" android:textSize="11sp" android:textColor="#738096" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center" />
    <TextView android:id="@+id/page_next" android:layout_width="48dp" android:layout_height="36dp" android:text="@string/ui_widget_v110_30_text" android:textSize="23sp" android:textColor="#6550CC" android:includeFontPadding="false" android:gravity="center" android:contentDescription="@string/ui_widget_v110_30_contentdescription" />
  </LinearLayout>
  <TextView android:id="@+id/warning" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_31_text" android:textSize="9sp" android:textColor="#738096" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/updated" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/ui_widget_v110_33_text" android:textSize="10sp" android:textColor="#738096" android:includeFontPadding="false" android:layout_weight="1" android:maxLines="2" />
    <TextView android:id="@+id/open_app" android:layout_width="65dp" android:layout_height="40dp" android:text="@string/ui_widget_v110_34_text" android:textSize="11sp" android:textColor="#6550CC" android:includeFontPadding="false" android:textStyle="bold" android:gravity="center" />
    <TextView android:id="@+id/refresh" android:layout_width="83dp" android:layout_height="40dp" android:text="@string/ui_widget_v110_35_text" android:textSize="11sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:textStyle="bold" android:gravity="center" android:background="@drawable/primary_button" />
  </LinearLayout>
</LinearLayout>